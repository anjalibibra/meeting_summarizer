# Meeting Summarizer — Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env with real keys — it is in .gitignore.

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite in the project root. Swap to a postgres URL for production.
# DATABASE_URL=sqlite:///./meeting_summarizer.db
# DATABASE_URL=postgresql://user:password@localhost:5432/meeting_summarizer

# ── LLM configuration ─────────────────────────────────────────────────────────
# Provider: openai | stub (stub returns fake responses for development/testing)
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-openai-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# ── ASR configuration ─────────────────────────────────────────────────────────
# Provider: whisper | faster_whisper | stub
ASR_PROVIDER=whisper
# Model size: tiny | base | small | medium | large
# 'base' is a good default: fast enough for development, accurate enough for demos
# Use 'small' or 'medium' for better accuracy at the cost of speed
WHISPER_MODEL_SIZE=base

# ── Speaker diarization ───────────────────────────────────────────────────────
# Required only if ASR_PROVIDER is not stub and you want pyannote diarization.
# Get a token at https://huggingface.co/settings/tokens
# You must also accept the model license at:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
# If not set, the app falls back to heuristic diarization automatically.
# HUGGINGFACE_TOKEN=hf_your_token_here

# ── File upload limits ────────────────────────────────────────────────────────
MAX_UPLOAD_MB=500
CHUNK_DURATION_SECONDS=600

# ── Confidence thresholds ─────────────────────────────────────────────────────
# Segments below LOW_CONFIDENCE_THRESHOLD are highlighted in the UI.
LOW_CONFIDENCE_THRESHOLD=0.6
# Diarization below DIARIZATION_CONFIDENCE_THRESHOLD is labelled "uncertain speaker".
DIARIZATION_CONFIDENCE_THRESHOLD=0.7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes)
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
